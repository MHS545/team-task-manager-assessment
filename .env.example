NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
# Local only: absolute path to the private service account JSON. Never commit the key.
# On Cloud Run use its service account identity; do not deploy a JSON key.
GOOGLE_APPLICATION_CREDENTIALS=
# Required in production. Development uses memory if omitted.
DATABASE_URL=
# For a remote PostgreSQL server requiring TLS:
PG_SSL=false
PG_CA_BASE64=
# Optional local Firestore emulator. Never set in production:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Vercel only: sensitive server secret containing Firebase Admin service account JSON.
# Never prefix with VITE_ or commit actual credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
